generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Estampa {
  id        String   @id @default(cuid())
  name      String
  quantity  Int      @default(0)
  minStock  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("estampas")
}

enum ProductSourceType {
  OWN_STOCK
  DROPSHIPPING
}

model Product {
  id               String            @id @default(cuid())
  name             String
  sku              String            @unique
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  groupId          String?
  group            ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  color            String?
  size             String?
  pattern          String?
  stockQuantity    Int               @default(0)
  minStock         Int               @default(0)
  sourceType       ProductSourceType @default(DROPSHIPPING)
  stockDisplayName String?
  stockSortOrder   Int               @default(0)
  costPrice        Decimal           @default(0) @db.Decimal(12, 2)
  salePrice        Decimal           @default(0) @db.Decimal(12, 2)
  netReceivedPrice Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  imageUrl         String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  purchaseItems  PurchaseItem[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@map("products")
  @@index([categoryId])
  @@index([groupId])
}

model ProductGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_groups")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  whatsapp  String?
  city      String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime
  freight      Decimal        @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  items        PurchaseItem[]
  expense      Expense?

  @@map("purchases")
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
  @@index([purchaseId])
  @@index([productId])
}

enum SaleOrigin {
  MANUAL
  SHOPEE
  OTHER
}

model Sale {
  id             String     @id @default(cuid())
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  quantity       Int
  totalAmount    Decimal    @db.Decimal(12, 2)
  unitCostAtSale Decimal    @db.Decimal(12, 2)
  profit         Decimal    @db.Decimal(12, 2)
  origin         SaleOrigin @default(MANUAL)
  saleDate       DateTime
  createdAt      DateTime   @default(now())

  @@map("sales")
  @@index([productId])
  @@index([saleDate])
}

enum ExpenseCategory {
  EMBALAGEM
  FRETE
  MARKETING
  TRANSPORTE
  COMPRA_PRODUTOS
  OUTROS
}

enum ExpenseSource {
  MANUAL
  PURCHASE
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  source      ExpenseSource   @default(MANUAL)
  purchaseId  String?         @unique
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id])
  createdAt   DateTime        @default(now())

  @@map("expenses")
  @@index([date])
  @@index([category])
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantityDelta Int
  referenceId   String?
  reason        String?
  createdAt     DateTime          @default(now())

  @@map("stock_movements")
  @@index([productId])
}
