generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Estampa {
  id        String   @id @default(cuid())
  name      String
  quantity  Int      @default(0)
  minStock  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("estampas")
}

enum ProductSourceType {
  OWN_STOCK
  DROPSHIPPING
}

model Product {
  id               String            @id @default(cuid())
  name             String
  sku              String            @unique
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  groupId          String?
  group            ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  color            String?
  size             String?
  pattern          String?
  stockQuantity    Int               @default(0)
  minStock         Int               @default(0)
  sourceType       ProductSourceType @default(DROPSHIPPING)
  stockDisplayName String?
  stockSortOrder   Int               @default(0)
  costPrice        Decimal           @default(0) @db.Decimal(12, 2)
  salePrice        Decimal           @default(0) @db.Decimal(12, 2)
  netReceivedPrice Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  imageUrl         String?
  active           Boolean           @default(true)
  shopeeItemId     String?           @unique
  shopeeModelId    String?
  // shopId da loja Shopee de origem; nulo em produtos cadastrados manualmente
  shopeeShopId     String?
  // SKU do anúncio na Shopee (pode repetir entre anúncios); o sku do produto é único no sistema
  shopeeSku        String?
  costGroupId      String?
  costGroup        CostGroup?        @relation(fields: [costGroupId], references: [id], onDelete: SetNull)
  // update_time do anúncio no último sync; só busca as variações de novo se o anúncio mudou
  shopeeUpdateTime Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  purchaseItems  PurchaseItem[]
  variations     ProductVariation[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([groupId])
  @@index([shopeeShopId])
  @@index([costGroupId])
  @@map("products")
}

model ProductGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_groups")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  whatsapp  String?
  city      String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime
  freight      Decimal        @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  items        PurchaseItem[]
  expense      Expense?

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

enum SaleOrigin {
  MANUAL
  SHOPEE
  OTHER
}

model Sale {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  quantity       Int
  totalAmount    Decimal           @db.Decimal(12, 2)
  unitCostAtSale Decimal           @db.Decimal(12, 2)
  profit         Decimal           @db.Decimal(12, 2)
  origin         SaleOrigin        @default(MANUAL)
  shopeeOrderSn  String?
  // variação vendida (vendas da Shopee); o custo da venda vem dela
  variationId    String?
  variation      ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  saleDate       DateTime
  createdAt      DateTime          @default(now())

  @@unique([shopeeOrderSn, variationId])
  @@index([variationId])
  @@index([productId])
  @@index([saleDate])
  @@map("sales")
}

model ShopeeShop {
  id                    String    @id @default(cuid())
  shopId                String    @unique
  shopName              String?
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  lastProductSyncAt     DateTime?
  lastOrderSyncAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("shopee_shops")
}

enum ExpenseCategory {
  EMBALAGEM
  FRETE
  MARKETING
  TRANSPORTE
  COMPRA_PRODUTOS
  OUTROS
}

enum ExpenseSource {
  MANUAL
  PURCHASE
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  source      ExpenseSource   @default(MANUAL)
  purchaseId  String?         @unique
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([category])
  @@map("expenses")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantityDelta Int
  referenceId   String?
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([productId])
  @@map("stock_movements")
}

// Grupo de custo (ex.: "Moletom Adulto" = R$ 39): os produtos do grupo herdam o custo
model CostGroup {
  id         String             @id @default(cuid())
  name       String
  cost       Decimal            @db.Decimal(12, 2)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  products   Product[]
  variations ProductVariation[]

  @@map("cost_groups")
}

// Variação de um anúncio da Shopee (ex.: "Preto / 8 anos"); cada uma pode ter o seu custo.
// Anúncio sem variações tem uma variação única (modelo 0).
model ProductVariation {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  // "<item_id>:<model_id>"
  shopeeKey   String     @unique
  name        String     @default("")
  shopeeSku   String?
  costGroupId String?
  costGroup   CostGroup? @relation(fields: [costGroupId], references: [id], onDelete: SetNull)
  costPrice   Decimal    @default(0) @db.Decimal(12, 2)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sales       Sale[]

  @@index([productId])
  @@index([costGroupId])
  @@map("product_variations")
}
